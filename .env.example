BOT_TOKEN=123456:REPLACE_ME
DATABASE_URL=postgresql+asyncpg://wb_bot:REPLACE_ME@db:5432/wb_task_bot
POSTGRES_USER=wb_bot
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=wb_task_bot
GOOGLE_SHEETS_CREDENTIALS_FILE=/app/credentials/service_account.json
# Начальное значение; после запуска меняется через /admin -> Синхронизация
GOOGLE_SHEETS_SPREADSHEET_ID=REPLACE_ME
ENCRYPTION_KEY=
LOG_LEVEL=INFO

# Веб-админка (webadmin/), см. docs/superpowers/specs/2026-07-15-web-admin-dashboard-design.md
WEBADMIN_PASSWORD=REPLACE_ME
CLIENT_PASSWORD=REPLACE_ME
WEBADMIN_SECRET_KEY=REPLACE_ME_RANDOM_STRING
# true за реальным HTTPS (деплой); false только для локального http://localhost
WEBADMIN_HTTPS_ONLY=true
